def biplot_gen(explained_variance,folder,pca_data,loadings,PC_matrix,PCA_info,Name):

    for i, var in enumerate(zip(explained_variance)):
        if i%2==0 and i!=explained_variance.size-1:
            folder_name = os.path.join(folder, f'{Name} PCA')
            ensure_dir_exists(folder_name)
            biplot_filename = os.path.join(folder_name, f"distance biplot PC {i} and {i+1}.html")
            plotly_distance_biplot(pca_data, loadings, PC_matrix, comp_x=i, comp_y=i+1, scale_arrow=1.0, output_file=biplot_filename)
        PCA_info.at[f"PCA {i}", f"Explained variance {Name} PCA"] = str(var[0])
        

def bar_chart(data,Property,path):
    bins = np.linspace(0, 1, 11)  # 10 bins between 0 and 1

    # Compute histogram
    counts, edges = np.histogram(data, bins)
    # Plot bar chart
    plt.figure()
    plt.bar(edges[:-1], counts, width=0.1, align='edge', edgecolor='black')
    plt.xlabel('Relative Temperature')
    plt.ylabel('Frequency')
    plt.title(f"errors for {Property}")
    plt.xticks(edges, rotation=45)
    plt.grid(axis='y', linestyle='--', alpha=0.7)
    plt.savefig(f"{path}/{Property} error distributions.png")
    plt.close()

def group_graphs(PCA_submatrix,path):
    for group,submatrix in PCA_submatrix.items():
        for prop in list(submatrix.columns):
            folder = os.path.join(path, str(group))
            if not os.path.exists(folder):
                os.makedirs(folder)
            name = os.path.join(folder, f"{prop}.html")
            y = list(submatrix.loc[:,"fugacity"])
            x = list(submatrix.loc[:,prop])
            names = submatrix.index
            
            fig = px.scatter(x=x, y=y, hover_name=names, labels={'x': prop, 'y': 'fugacity coefficient'})
            fig.write_html(name)
def total_graph(PCA_matrix,path,EOS):
    for prop in list(PCA_matrix.columns):
        folder = os.path.join(path, EOS)
        ensure_dir_exists(folder)
        name = os.path.join(folder, f"{prop}.html")
        y = list(PCA_matrix.loc[:,"fugacity"])
        x = list(PCA_matrix.loc[:,prop])
        names = PCA_matrix.index
        fig = px.scatter(x=x, y=y, hover_name=names, labels={'x': prop, 'y': 'fugacity coefficient'})
        fig.write_html(name)
        
