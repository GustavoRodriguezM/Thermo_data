def plot_groups(df, groups_dict, path):
    #print(f"df = {df}")
    col_names = df.columns
    col_pairs = list(itertools.combinations(col_names, 2))  # All unique column pairs

    for x_col, y_col in col_pairs:
        fig, ax = plt.subplots(figsize=(10, 8))
        colors = plt.cm.get_cmap('tab10', len(groups_dict))

        for j, (group_id, compounds) in enumerate(groups_dict.items()):
            group_df = df.loc[compounds]
            ax.scatter(group_df[x_col], group_df[y_col], label=f'Group {group_id}', s=50, color=colors(j))
            try:
                x_mean = group_df[x_col].mean()
            except:
                x_mean = 0
                
            try:
                y_mean = group_df[y_col].mean()
            except:
                y_mean = 0
            
            x_numeric = pd.to_numeric(group_df[x_col], errors='coerce')
            x_std = x_numeric.std()
            y_numeric = pd.to_numeric(group_df[y_col], errors='coerce')
            y_std = y_numeric.std()
            
            ellipse = Ellipse((x_mean, y_mean), width=2.5 * x_std, height=2.5 * y_std,
                              edgecolor=colors(j), facecolor='none', linewidth=2)
            ax.add_patch(ellipse)

            for compound, row in group_df.iterrows():
                ax.text(row[x_col], row[y_col], compound, fontsize=8, ha='right', va='bottom')

        ax.set_xlabel(x_col)
        ax.set_ylabel(y_col)
        ax.legend()
        ax.set_title(f'Grouped Compounds: {x_col} vs {y_col}')
        plt.grid(True)
        plt.tight_layout()
        filename = f"{x_col} vs {y_col}.png"
        full_path = os.path.join(path, filename)
        plt.savefig(full_path)
        plt.close()

def grouper(df, groups, path, eos,name):
    des = os.path.join(path, "groups" ,eos,name)
    
    group_path = os.path.join(path, "groups" )
    eos_path = os.path.join(path, "groups",eos )
    name_path = os.path.join(path, "groups",eos,name )
    
    ensure_dir_exists(group_path)
