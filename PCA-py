def clusterer(num_clusters, reconstructed_scaled_data, compound_names, PC_matrix, PCA_submatrix, EOS):
    inertias = []
    groupings = {}
    clus_info_blocks = []
    max_cluster_length = 0
    n_canon = 0
    K = range(2, min(len(reconstructed_scaled_data), 15))
    

    for k in K:
        
        kmeans = KMeans(n_clusters=k, random_state=42)
        labels = kmeans.fit_predict(reconstructed_scaled_data)

        clusters = {}
        for name, label in zip(compound_names, labels):
            clusters.setdefault(label, []).append(name)

        groupings[k] = clusters
        if any(len(values) == 1 for values in clusters.values()):
            n_canon = k
        cluster_cols = []
        col_names = []

        for label, names in sorted(clusters.items()):
            cluster_cols.append(pd.Series(names))
            col_names.append(f'k{k}_cluster_{label}')

        df_k = pd.concat(cluster_cols, axis=1)
        df_k.columns = col_names
        clus_info_blocks.append(df_k)

        # Add spacer column (with '.' in top row only)
        spacer1 = pd.DataFrame({f' . ': ['.'] + [None] * (df_k.shape[0] - 1)})
        spacer2 = pd.DataFrame({f' . ': ['.'] + [None] * (df_k.shape[0] - 1)})
        spacer3 = pd.DataFrame({f' . ': ['.'] + [None] * (df_k.shape[0] - 1)})
        clus_info_blocks.append(spacer1)
        clus_info_blocks.append(spacer2)
        clus_info_blocks.append(spacer3)

        max_cluster_length = max(max_cluster_length, df_k.shape[0])


        if k == n_canon:
            for label, names in clusters.items():
                PCA_submatrix[label] = PC_matrix.loc[names, :]

    # Remove final spacer column
    if clus_info_blocks:
        clus_info_blocks = clus_info_blocks[:-1]

    # Reindex all to same number of rows
    for i in range(len(clus_info_blocks)):
        clus_info_blocks[i] = clus_info_blocks[i].reindex(range(max_cluster_length))

    # Concatenate everything
    clus_info = pd.concat(clus_info_blocks, axis=1)


    return clus_info, PCA_submatrix, groupings



def affinity_clusterer(num_clusters,reconstructed_scaled_data, compound_names, PC_matrix, PCA_submatrix, EOS):
    # Fit Affinity Propagation (auto-determines number of clusters)
    affinity = AffinityPropagation(random_state=42)
    labels = affinity.fit_predict(reconstructed_scaled_data)
    # Organize compound names into clusters
    clusters = {}
    for name, label in zip(compound_names, labels):
        clusters.setdefault(label, []).append(name)

    clus_info = pd.DataFrame({key: pd.Series(value) for key, value in clusters.items()})

    for key, value in clusters.items():
        PCA_submatrix[key] = PC_matrix.loc[value, :]
    return clus_info, PCA_submatrix

def PCA_(EOS, excluded_subtances,name,path, robust=False):
    #excluded_subtances.extend(['n-Nonane','n-Undecane','n-Decane'])
    #print("excluded_subtances = ",excluded_subtances)
    global compounds 
    PCA_submatrix = {}
    clus_info = pd.DataFrame()
    valid_compounds = set(compounds) & set(data_main[EOS].keys())
    data1, PC_matrix, NaN_sheet_global1, Inf_sheet_global1, Total_sheet_global,den_sat,fug_sat,sres_sat,hv,vp,Median_sheet_global, Median_sheet_global, Mean_sheet_phases, Median_sheet_phases,Mean_sheet_global,Mean_aceptors_global, Median_aceptors_global, Mean_donors_global, Median_donors_global, Median_chains_global, Mean_chains_global, Median_apolar_global, Mean_apolar_global, Mean_aceptors_phases, Median_aceptors_phases, Mean_donors_phases, Median_donors_phases, Median_chains_phases, Mean_chains_phases, Median_apolar_phases, Mean_apolar_phases  = Matrix_generator(EOS, excluded_subtances, type)
    
    properties = eval_props
    
    
    nan_positions = PC_matrix.isna().stack()
    nan_locations = nan_positions[nan_positions].index.tolist()
    #print("NaN positions (row, col):", nan_locations)
    allowed_compounds = set(valid_compounds) - set(excluded_subtances)
    
    
    # Clean data
    data1[data1 > 1e10] = 1e10
    scaler = StandardScaler()
    scaled_data = scaler.fit_transform(data1)
    #print("scaled_data = ",scaled_data)
    # Robust PCA or standard PCA
    if robust:
        rpca = R_pca(scaled_data)
        L, S = rpca.fit(max_iter=10000, iter_print=100)
    else:
        L = scaled_data
        S = np.zeros(L.shape)

    # Fit PCA on the low-rank matrix
    pca = PCA(n_components=None)
    pca.fit(L)
    full_pca_data = pca.transform(scaled_data)

    # Select number of PCs to keep (>=99% variance)
    explained_variance = pca.explained_variance_ratio_
    cumulative_variance = np.cumsum(explained_variance)
    #print("explained variance = ",explained_variance)
    #print("cumulative variance = ",cumulative_variance)
    #print("Index 99% = ",np.where(cumulative_variance >= 0.99))
    important_components = np.where(cumulative_variance >= 0.99)[0][0] + 1

    
    # Reduce PCA data and transform back to original space
    limited_data = full_pca_data[:, :important_components]
    reconstructed_scaled_data = pca.inverse_transform(np.hstack([limited_data, np.zeros((limited_data.shape[0], pca.n_components_ - important_components))]))


    # If compound names are the index:
    compound_names = PC_matrix.index.tolist()


    # Run DBSCAN
    num_clusters = 2
    clus_info,PCA_submatrix,groups = clusterer(num_clusters,reconstructed_scaled_data,compound_names,PC_matrix,PCA_submatrix,EOS)
    grouper(PC_matrix, groups, path, EOS,name)
    try:
    
        clus_info,PCA_submatrix,groups = clusterer(num_clusters,reconstructed_scaled_data,compound_names,PC_matrix,PCA_submatrix,EOS)
    except:
        []
    
    # Rescale back to original data space
    reduced_data = scaler.inverse_transform(reconstructed_scaled_data+S)

    # PCA coordinate matrix and loadings for the retained components
    PCA_coordinates = pd.DataFrame(np.array(full_pca_data), index = PC_matrix.index, columns=[f"PC{i+1}" for i in range(len(pca.components_))])
    loadings = pd.DataFrame(pca.components_.T, index=properties, columns=[f"PC{i+1}" for i in range(len(pca.components_))])

    # Rescale L and S matrices
    L_rescaled = L / scaled_data
    S_rescaled = S / scaled_data
    L_sheet = pd.DataFrame(L_rescaled, index=list(allowed_compounds), columns=properties)
    S_sheet = pd.DataFrame(S_rescaled, index=list(allowed_compounds), columns=properties)

    # Return the reconstructed original data using only the top components
    reconstructed_df = pd.DataFrame(reduced_data, index=PC_matrix.index, columns=properties)

    return reconstructed_df, reduced_data, PC_matrix, NaN_sheet_global1, Inf_sheet_global1, explained_variance, PCA_coordinates, loadings, L_sheet, S_sheet, reconstructed_df, clus_info, PCA_submatrix

