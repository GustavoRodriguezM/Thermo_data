def outlier_detector(PC_matrix,pca_data,loadings):
    compounds = PC_matrix.index
    PC_values = np.array(pca_data)
    outliers = pd.DataFrame()  
    Compounds= set()
    for i in range(0,PC_values.shape[1]):
        Analysed = PC_values[:,i]
        outli = np.where(Analysed > 3)
        if not outli:
            continue
        elif isinstance(outli, int):
            outli = [outli]
        else:
            outli = outli[0].tolist()

        for index in outli:
            Compounds.add(compounds[index])
            for row in loadings.index.tolist():
                outliers.at[compounds[index], row] = loadings.loc[row, f"PC{i+1}"]
            

    return outliers, Compounds


def plot_error_distribution(errors,prop,path,title, bins=50):
    errors = np.array(errors).flatten()
    counts, bin_edges = np.histogram(errors, bins=bins)
    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
    plt.figure(figsize=(8, 5))
    plt.bar(bin_centers, counts, width=(bin_edges[1]-bin_edges[0]), edgecolor='black', alpha=0.7)
    plt.xlabel(f"Error {prop}")
    plt.ylabel('Frequency')
    plt.title(f"Error Distribution {prop}")
    plt.grid(axis='y', alpha=0.3)
    plt.savefig(f"{path}/{title}.png")



def plotly_distance_biplot(pca_data, loadings, df, comp_x=0, comp_y=1, scale_arrow=1.0, output_file="biplot.html"):
    # Create an interactive distance biplot in Plotly where labels only appear on hover.
    x_scores = pca_data[:, comp_x]
    y_scores = pca_data[:, comp_y]

    trace_points = go.Scatter(
        x = x_scores,
        y = y_scores,
        mode = 'markers',
        marker = dict(color='gray', size=8),
        hovertemplate = "<b>Sample:</b> %{customdata}<br>" +
                        "PC"+str(comp_x+1)+": %{x:.2f}<br>" +
                        "PC"+str(comp_y+1)+": %{y:.2f}<extra></extra>",
        customdata = df.index,
        name = 'Samples'
    )

    max_score = max(np.abs(x_scores).max(), np.abs(y_scores).max())
    arrow_scale = scale_arrow * max_score

    arrow_x = []
    arrow_y = []
    arrow_hover = []

    arrow_annotations = []
    for i, feature in enumerate(loadings.index):
        loading_x = loadings.iloc[i, comp_x]
        loading_y = loadings.iloc[i, comp_y]
        end_x = loading_x * arrow_scale
        end_y = loading_y * arrow_scale

        arrow_x.append(end_x)
        arrow_y.append(end_y)
        arrow_hover.append(feature)

        arrow_annotations.append(dict(
            ax=0, ay=0,
            x=end_x, y=end_y,
            xref="x", yref="y",
            axref="x", ayref="y",
            showarrow=True,
            arrowhead=3,
            arrowsize=1.5,
            arrowwidth=2,
            arrowcolor="red",
            standoff=0
        ))

    trace_arrows = go.Scatter(
        x = arrow_x,
        y = arrow_y,
        mode = 'markers',
        marker = dict(color='red', size=8),
        hovertemplate = "<b>Variable:</b> %{customdata}<br>" +
                        "PC"+str(comp_x+1)+": %{x:.2f}<br>" +
                        "PC"+str(comp_y+1)+": %{y:.2f}<extra></extra>",
        customdata = arrow_hover,
        name = 'Variables'
    )

    fig = go.Figure(data=[trace_points, trace_arrows])
    fig.update_layout(annotations=arrow_annotations)

    fig.update_layout(
        shapes=[
            dict(type="line", x0=min(x_scores)*1.2, x1=max(x_scores)*1.2, y0=0, y1=0, line=dict(color="black", width=1)),
            dict(type="line", x0=0, x1=0, y0=min(y_scores)*1.2, y1=max(y_scores)*1.2, line=dict(color="black", width=1))
        ]
    )

    fig.update_layout(
        title=f"Distance Biplot: PC{comp_x+1} vs. PC{comp_y+1}",
        xaxis_title=f"PC{comp_x+1}",
        yaxis_title=f"PC{comp_y+1}",
        template="plotly_white",
        width=800,
        height=600
    )

    fig.write_html(output_file)

def update_excluded_log(EOS, excluded_compounds):
    log_file = 'excluded_compounds_log.xlsx'

    # Check if the log file already exists
    if os.path.exists(log_file):
        excluded_log_df = pd.read_excel(log_file, index_col=0)
    else:
        excluded_log_df = pd.DataFrame()

    # Create a DataFrame with the excluded compounds
    excluded_df = pd.DataFrame({EOS: list(excluded_compounds)}, index=range(len(excluded_compounds)))

    # Concatenate and remove duplicate columns only if there are existing columns
    if not excluded_log_df.empty:
        temp_df = pd.concat([excluded_log_df, excluded_df], axis=1)
        excluded_log_df = temp_df.loc[:, ~temp_df.columns.duplicated()]
    else:
        excluded_log_df = excluded_df

    # Save the updated log
    excluded_log_df.to_excel(log_file)


