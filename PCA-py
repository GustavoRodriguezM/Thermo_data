def Error_spliter______(Matrix, vp_CES, vp_CP, N, T, P, Tc_CP, Pc_CP,Tc_CES, Pc_CES, Tsat_CP,Tsat_CES):
    Pc_CP_ind, Tc_CP_ind = bisect(P, Pc_CP), bisect(T, Tc_CP)
    Pc_CES_ind, Tc_CES_ind = bisect(P, Pc_CES), bisect(T, Tc_CES)
    vp_CES_index = [bisect(P, i) for i in vp_CES]
    vp_CP_index = [bisect(P, i) for i in vp_CP]

    Error_supercritical_liquid = Matrix[0:Tc_CP_ind, Pc_CP_ind:N].flatten()
    Error_supercritical_gas = Matrix[Tc_CP_ind:N, 0:Pc_CP_ind].flatten()
    Error_supercritical = Matrix[Tc_CP_ind:N, Pc_CP_ind:N].flatten()
    Error_rest_liquid = np.array([])
    Error_rest_gas = np.array([])

    if Tc_CP>Tc_CES:
        for vp_CES_ind, vp_CP_ind, T_CES in zip(vp_CES_index, vp_CP_index,Tsat_CES):  
            
            Tsat_ind = bisect(Tsat_CES, T_CES)
            Error_rest_gas = np.append(Error_rest_gas, Matrix[Tsat_ind, 0:min(vp_CES_ind, vp_CP_ind)].flatten())
            Error_rest_liquid = np.append(Error_rest_liquid, Matrix[Tsat_ind, max(vp_CES_ind, vp_CP_ind):Pc_CP_ind].flatten())
    elif  Tc_CES>Tc_CP:
        for vp_CES_ind, vp_CP_ind, T_CP in zip(vp_CES_index, vp_CP_index,Tsat_CP):  
            Tsat_ind = bisect(Tsat_CP, T_CP)
            Error_rest_gas = np.append(Error_rest_gas, Matrix[Tsat_ind, 0:min(vp_CES_ind, vp_CP_ind)].flatten())
            Error_rest_liquid = np.append(Error_rest_liquid, Matrix[Tsat_ind, max(vp_CES_ind, vp_CP_ind):Pc_CP_ind].flatten())
    elif  Tc_CES==Tc_CP:
        for vp_CES_ind, vp_CP_ind, T_CP in zip(vp_CES_index, vp_CP_index,Tsat_CP):  
            Tsat_ind = bisect(Tsat_CP, T_CP)
            Error_rest_gas = np.append(Error_rest_gas, Matrix[Tsat_ind, 0:min(vp_CES_ind, vp_CP_ind)].flatten())
