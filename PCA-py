def ensure_dir_exists(path):
    if not os.path.exists(path):
        os.makedirs(path, exist_ok=True)


def get_next_attempt_dir(base_path):
    # Ensure the base path exists
    ensure_dir_exists(base_path)
    
    # Check existing attempt directories
    attempt_dirs = [d for d in os.listdir(base_path) if d.startswith('attempt')]
    if not attempt_dirs:
        return os.path.join(base_path, 'attempt 1')

    # Determine the highest attempt number and add 1
    attempt_numbers = [int(d.split()[1]) for d in attempt_dirs]
    next_attempt_number = max(attempt_numbers) + 1
    return os.path.join(base_path, f'attempt {next_attempt_number}')

