def rho_liquid(T, Tc, rho_c, param_values):
    tau = 1 - T / Tc
    params = np.concatenate([np.array(param_values), np.zeros(4 - len(param_values))])
    ln_rho = (params[0] * tau**(2/6) + params[1] * tau**(3/6) + 
              params[2] * tau**(7/6) + params[3] * tau**(9/6))
    return rho_c * np.exp(ln_rho)

def rho_altern(T, Tc, rho_c, param_values):
    params = np.concatenate([np.array(param_values), np.zeros(4 - len(param_values))])
    rho = rho_c * np.abs(params[0]) ** (-(np.abs(1 - T / Tc)) ** params[1])
    return rho

def rho_vapor(T, Tc, rho_c, param_values):
    tau = 1 - T / Tc
    params = np.concatenate([np.array(param_values), np.zeros(5 - len(param_values))])
    ln_rho = (params[0] * tau**(2/6) + params[1] * tau**(4/6) + 
              params[2] * tau**(7/6) + params[3] * tau**(13/6) + 
              params[4] * tau**(25/6))
    return rho_c * np.exp(ln_rho)



def adjuster(x, y, fun, N):
    params = np.array([])
    AAD = 10000000
    
    for num_param in range(1, N + 1):
        guess = np.ones(num_param)
        if len(params) > 0:
            guess[:len(params)] = params
        
        try:
            popt, pcov = curve_fit(fun, x, y, p0=guess, maxfev=10000)
            params = popt
            pred = fun(x, *params)
            AAD = np.sum(np.abs(pred - y)) / len(y)
        except RuntimeError:
            # Handle cases where curve_fit fails to converge
            print(f"Warning: curve_fit failed to converge for {num_param} parameters")
            break
    
    return params, AAD


def fit_densities(Tc, rho_c, T, rho_sat_vapor, rho_sat_liquid, print_AAD=False, plot=False):
    f_liq, f_vap, liquid_params, vapor_params = None, None, None, None

    def wrap_liq(T, *p):
        return rho_liquid(T, Tc, rho_c, p)
    
    def wrap_vap(T, *p):
        return rho_vapor(T, Tc, rho_c, p)
    
    def wrap_alt(T, *p):
        return rho_altern(T, Tc, rho_c, p)

    # Apply masks
    mask_below_Tc = T < Tc
    mask_T_min = T > Tc * 0
    is_not_nan = np.isfinite(rho_sat_liquid)
    

    # Filter arrays using boolean indexing
    T_filtered = T[mask_below_Tc & mask_T_min & is_not_nan]
    rho_sat_liquid_filtered = rho_sat_liquid[mask_below_Tc & mask_T_min & is_not_nan]
    rho_sat_vapor_filtered = rho_sat_vapor[mask_below_Tc & mask_T_min & is_not_nan]

    # Fit liquid density
    try:
        liquid_params, AAD = adjuster(T_filtered, rho_sat_liquid_filtered, wrap_liq, 4)
        f_liq = lambda T: wrap_liq(T, *liquid_params)
        if print_AAD:
            print(f"Liquid AAD: {AAD}")
    except Exception as e:
        print(f"Liquid fit failed with 4 parameters, trying alternative: {e}")
        try:
            liquid_params, AAD = adjuster(T_filtered, rho_sat_liquid_filtered, wrap_alt, 2)
            f_liq = lambda T: wrap_alt(T, *liquid_params)
            if print_AAD:
                print(f"Liquid alternative AAD: {AAD}")
        except Exception as e2:
            print(f"Liquid alternative fit also failed: {e2}")
            return None, None

    # Fit vapor density
    try:
        vapor_params, AAD = adjuster(T_filtered, rho_sat_vapor_filtered, wrap_vap, 5)
        f_vap = lambda T: wrap_vap(T, *vapor_params)
        if print_AAD:
            print(f"Vapor AAD: {AAD}")
    except Exception as e:
        print(f"Vapor fit failed with 5 parameters, trying alternative: {e}")
        try:
            vapor_params, AAD = adjuster(T_filtered, rho_sat_vapor_filtered, wrap_alt, 2)
            f_vap = lambda T: wrap_alt(T, *vapor_params)
            if print_AAD:
                print(f"Vapor alternative AAD: {AAD}")
        except Exception as e2:
            print(f"Vapor alternative fit also failed: {e2}")
            return None, None


    return f_liq, f_vap

def replacer(Tc, rho_c, T, rho_sat_vapor, rho_sat_liquid, print_AAD=False, plot=False):
    f_liq, f_vap = fit_densities(Tc, rho_c, T, rho_sat_vapor, rho_sat_liquid, print_AAD, plot)
    for i,t in enumerate(T):
        liq_ext = f_liq(t)
        vap_ext = f_vap(t)
        liq_err = np.abs( (liq_ext - rho_sat_liquid[i])/liq_ext )
        vap_err = np.abs( (vap_ext - rho_sat_vapor[i])/vap_ext )
        if liq_err>100:
            rho_sat_liquid[i] = liq_err
        if vap_err>100:
            rho_sat_vapor[i] = vap_err  
    return rho_sat_vapor,rho_sat_liquid



def Error_spliter(Matrix, vp_CES, vp_CP, N, T, P, Tc_CP, Pc_CP,Tc_CES, Pc_CES, Tsat_CP,Tsat_CES):

    # Find critical indices (no +1 needed in Python)
    Pc_CES_ind = bisect_left(P, Pc_CES)
    Tc_CES_ind = bisect_left(T, Tc_CES)
    Pc_CP_ind = bisect_left(P, Pc_CP)
    Tc_CP_ind = bisect_left(T, Tc_CP)
    vp_CES_ind = [bisect(P, i) for i in vp_CES]
    vp_CP_ind = [bisect(P, i) for i in vp_CP]
    
    # Initialize masks
    mask_supercritical_liquid = np.full(Matrix.shape, False, dtype=bool)
    mask_supercritical_gas = np.full(Matrix.shape, False, dtype=bool)
    mask_supercritical = np.full(Matrix.shape, False, dtype=bool)
    mask_liquid = np.full(Matrix.shape, False, dtype=bool)
    mask_gas = np.full(Matrix.shape, False, dtype=bool)

    # Supercritical region
    mask_supercritical_liquid[0:Tc_CP_ind, Pc_CP_ind:N] = True
    mask_supercritical_gas[Tc_CP_ind:N, 0:Pc_CP_ind] = True
    mask_supercritical[Tc_CP_ind:N, Pc_CP_ind:N] = True
    
    if Tc_CP>Tc_CES:
        for vp_CES_i, vp_CP_i, T_CES in zip(vp_CES_ind, vp_CP_ind,Tsat_CES):
            vp_min = min(vp_CES_i, vp_CP_i)
            vp_max = max(vp_CES_i, vp_CP_i)
            Tsat_ind = bisect(Tsat_CES, T_CES)
            mask_gas[Tsat_ind, 0:vp_min] = True
            mask_liquid[Tsat_ind, vp_max:Pc_CP_ind] = True
    elif  Tc_CES>Tc_CP:
        for vp_CES_i, vp_CP_i, T_CP in zip(vp_CES_ind, vp_CP_ind,Tsat_CP): 
            vp_min = min(vp_CES_i, vp_CP_i)
            vp_max = max(vp_CES_i, vp_CP_i) 
            Tsat_ind = bisect(Tsat_CP, T_CP)
            mask_gas[Tsat_ind, 0:vp_min] = True
            mask_liquid[Tsat_ind, vp_max:Pc_CP_ind] = True
            
    elif  Tc_CES==Tc_CP:
        for vp_CES_i, vp_CP_i, T_CP in zip(vp_CES_ind, vp_CP_ind,Tsat_CP):
            vp_min = min(vp_CES_i, vp_CP_i)
            vp_max = max(vp_CES_i, vp_CP_i) 
            Tsat_ind = bisect(Tsat_CP, T_CP)
            mask_gas[Tsat_ind, 0:vp_min] = True
            mask_liquid[Tsat_ind, vp_max:Pc_CP_ind] = True

    return mask_supercritical_liquid | mask_supercritical_gas | mask_supercritical | mask_gas | mask_liquid , {
        "supercritical liquid": mask_supercritical_liquid,
        "supercritical gas": mask_supercritical_gas,
        "supercritical": mask_supercritical,
        "gas": mask_gas,
        "liquid": mask_liquid
    }


def interpolate_zone(Rho_CES,error, good,phase,T,P, meth="nearest"):
    Rho_error = np.zeros(Rho_CES.shape)
    Rho_good = np.zeros(Rho_CES.shape)
    Rho_error[phase] = error[phase]
    Rho_good[phase] = good[phase]

    Rho_error = Rho_error > 0
    Rho_good  = Rho_good  > 0


    
    points = np.column_stack((np.ravel(T[Rho_good]), np.ravel(P[Rho_good])))
    xi = np.column_stack((np.ravel(T[Rho_error]), np.ravel(P[Rho_error])))
    values = np.ravel(Rho_CES[Rho_good])
    interpolated_ = griddata(points,values,xi, method=meth)
    return interpolated_ 


def interpolator(Rho_CES, T, P, Rho_error, Rho_good,regions, method="nearest"):
    # Create grid
    
    Pgrid, Tgrid = np.meshgrid(P, T)

    # Split regions
    sup_reg_,sup_gas_reg_,sup_liq_reg_, gas_reg_, liq_reg_ = regions["supercritical"],regions["supercritical gas"],regions["supercritical liquid"], regions["gas"], regions["liquid"]
    print(sup_liq_reg_ , sup_reg_)
    sup_reg, gas_reg, liq_reg = sup_liq_reg_ | sup_reg_, sup_gas_reg_ | gas_reg_, liq_reg_


    # Pre-extract known phase data
    Rho_sup = Rho_error[sup_reg]
    Rho_gas = Rho_error[gas_reg]
    Rho_liq = Rho_error[liq_reg]
    
    result = np.zeros(Rho_CES.shape)

    # Decide which region (Tq, Pq) belongs to
    if np.any(Rho_sup):
        interpolated_sup = interpolate_zone(Rho_CES,Rho_error, Rho_good,sup_reg,Tgrid,Pgrid, meth=method)
        result[sup_reg & Rho_error ]     = interpolated_sup
    
    if np.any(Rho_gas):
        interpolated_gas = interpolate_zone(Rho_CES,Rho_error, Rho_good,gas_reg,Tgrid,Pgrid, meth=method)
        result[gas_reg & Rho_error ] = interpolated_gas
    
    if np.any(Rho_liq):
        interpolated_liq = interpolate_zone(Rho_CES,Rho_error, Rho_good,liq_reg,Tgrid,Pgrid, meth=method)
        result[liq_reg & Rho_error ] = interpolated_liq
    
    return result  


